# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Leave both empty to run the app local-only, without login.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy anon key. Both are
# safe in the browser; row level security is what protects the data.
# Never put the secret / service_role key here.
VITE_SUPABASE_PUBLISHABLE_KEY=
